{
  "name": "dsh-cannbot-connect",
  "version": "0.5.0",
  "description": "Bring CANNBOT gateway models into DeepSeek Harness by reusing CANNWork's opencode sign-in, with a live model roster, a Settings → CANNBOT page, and measured per-model image support.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "locale/*.json",
    "icon.svg",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/preview.svg",
    "docs/CONFIGURATION.md",
    "docs/TROUBLESHOOTING.md",
    "docs/SECURITY.md",
    "docs/INSTALL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:compat": "node scripts/host-matrix.mjs",
    "test:coverage": "node scripts/coverage.mjs",
    "test:e2e": "node e2e.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "node scripts/check-all.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentle-knight/dsh-cannbot-connect.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cannbot",
    "model-provider",
    "image-input"
  ],
  "displayName": "CANNBOT Connect",
  "icon": "icon.svg",
  "homepage": "https://github.com/gentle-knight/dsh-cannbot-connect#readme",
  "bugs": {
    "url": "https://github.com/gentle-knight/dsh-cannbot-connect/issues"
  }
}
