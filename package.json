{
  "name": "dsh-cannbot-connect",
  "version": "0.4.0",
  "private": true,
  "description": "Bring CANNBOT gateway models into DeepSeek Harness and into any OpenAI-compatible editor sidebar (VS Code chat), by reusing CANNWork's opencode sign-in (VK + JWT).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./local-server": "./lib/local-server.js"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node test/security.mjs && node test/credentials.mjs && node test/adapter-usage.mjs && node test/adapter-auth.mjs && node test/adapter-image.mjs && node test/local-server.mjs",
    "test:e2e": "node e2e.mjs",
    "serve": "node lib/local-server.js",
    "install:vscode": "node scripts/install-vscode.mjs",
    "install:launchd": "node scripts/install-launchd.mjs",
    "install:tunnel": "node scripts/install-remote-tunnel.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/gentle-knight/dsh-cannbot-connect.git"
  },
  "keywords": [
    "cannbot",
    "copilot-chat",
    "deepseek-harness",
    "dsh-plugin",
    "local-model-service",
    "model-provider",
    "openai-compatible",
    "vscode"
  ],
  "bin": {
    "cannbot-local": "./lib/local-server.js"
  }
}
